# Backend SaaS running locally or in staging.
BACKEND_URL=http://localhost:8000

# Recognition-service running locally or in staging.
RECOGNITION_SERVICE_URL=http://localhost:8001

# Optional frontend URL used as a sanity reference in the E2E docs.
FRONTEND_URL=http://localhost:5173

# Existing backend admin credentials. Required for /api/admin/system-health.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Existing normal school/user credentials. Do not use the admin account here.
TEST_SCHOOL_EMAIL=
TEST_SCHOOL_PASSWORD=

# Must match RECOGNITION_WEBHOOK_SECRET in backend and recognition-service.
RECOGNITION_WEBHOOK_SECRET=

# Must be accepted by recognition-service RECOGNITION_API_KEYS.
RECOGNITION_API_TOKEN=

# Keep true for the full responsaveis + NotificationOutbox validation.
E2E_REQUIRE_NOTIFICATIONS=true

# Responsible person created/linked to the disposable E2E student.
E2E_RESPONSAVEL_NOME=Responsável E2E
E2E_RESPONSAVEL_TELEFONE=+5588999999999
E2E_RESPONSAVEL_EMAIL=responsavel.e2e@example.com
E2E_RESPONSAVEL_PARENTESCO=responsavel

# These image files must exist before running the real E2E.
TEST_IMAGE_VALID=tools/e2e/assets/student_valid.jpg
TEST_IMAGE_SECOND_SAMPLE=tools/e2e/assets/student_second.jpg
TEST_IMAGE_NO_FACE=tools/e2e/assets/no_face.jpg

# Polling controls for async biometric status propagation.
E2E_POLL_SECONDS=30
E2E_POLL_INTERVAL_SECONDS=2
