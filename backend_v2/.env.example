# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BANCO DE DADOS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PostgreSQL principal do Supabase: use a conexão Session Pooler na porta 5432.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SEGURANÇA
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ENVIRONMENT=production
TRUST_PROXY_HEADERS=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BIOMETRIC_RETENTION_DAYS=365

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ADMIN
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# O admin é criado automaticamente no startup do backend se não existir.
# Se o login falhar com erro 401:
#   1. Sintomas: usuario encontrado, hash mismatch
#   2. Resolve:  python cli.py sync-admin
# Após mudar ADMIN_PASSWORD, sempre execute sync-admin
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=mudar-para-uma-senha-forte
ADMIN_SECRET_KEY=chave-admin-secreta

# Em AUTH_PROVIDER=local, o Render e a fonte unica da senha do admin.
SYNC_ADMIN_PASSWORD_ON_STARTUP=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FRONTEND
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
FRONTEND_URL=https://seu-frontend.vercel.app
AUTH_PROVIDER=local
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CLOUDINARY (Uploads de Fotos)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=seu-api-secret

# Servico externo de reconhecimento facial (opcional enquanto o modulo estiver fora do ar)
RECOGNITION_SERVICE_URL=https://seu-servico-de-reconhecimento
FACE_RECOGNITION_SERVICE_URL=https://seu-servico-de-reconhecimento/api/recognize
FACE_RECOGNITION_TIMEOUT_SECONDS=10
RECOGNITION_API_BASE_URL=https://seu-servico-de-reconhecimento
RECOGNITION_API_TIMEOUT_SECONDS=10
RECOGNITION_API_TOKEN=token-para-chamar-o-servico-de-reconhecimento
RECOGNITION_WEBHOOK_SECRET=segredo-para-webhook-de-presencas
MAX_IMAGE_UPLOAD_BYTES=5242880

# Notificacoes aos responsaveis
NOTIFICATION_PROVIDER=log
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM_PHONE_ID=
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_SECONDS=60

# Obrigatorio em production: rate limiting distribuido e worker Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Defina false se o backend for publicado sem um worker Celery separado.
CELERY_WORKER_REQUIRED=true
